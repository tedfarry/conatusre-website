---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
}

const { title, description, image, type, pubDate } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEO title={title} description={description} image={image} type={type} pubDate={pubDate} />
  </head>
  <body>
    <a href="#main" class="skip-to-content">Skip to content</a>
    <Header />
    <main class="main" id="main">
      <slot />
    </main>
    <Footer />
    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "CF_WEB_ANALYTICS_TOKEN"}'></script>
  </body>
</html>

<style>
  .main {
    padding-top: 72px;
    min-height: calc(100vh - 72px);
  }
</style>
