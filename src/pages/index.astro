---
import Base from '../layouts/Base.astro';
import BlogCard from '../components/BlogCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allCaseStudies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

---

<Base
  title="Conatus Real Estate — AI-Powered Operations Platforms"
  description="Custom AI-powered operations platforms for regulated industries — not SaaS, not off-the-shelf. 4,000+ SFR transactions, $1B+ in acquisitions capital. Deep operational expertise. Built with Claude."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__content" data-animate>
        <p class="hero__label">Operator-Built. AI-Powered.</p>
        <h1 class="hero__title">
          We've operated at scale.<br />
          <span class="accent">We build what we know works.</span>
        </h1>
        <p class="hero__subtitle">
          Custom AI-powered operations platforms designed by operators — not by product teams
          solving for the broadest possible market. We've executed 4,000+ SFR transactions
          across multiple institutional platforms. We know what breaks in the SaaS stack,
          what the workarounds cost you, and how to build the right fix.
        </p>
        <div class="hero__actions">
          <a href="/contact" class="btn btn--primary">Get in Touch</a>
          <a href="#case-studies" class="btn btn--outline">See Our Work</a>
        </div>
      </div>
      <div class="hero__visual" data-animate>
        <div class="visual-stage">
          <!-- Layer 1: Pipeline animation (behind) -->
          <div class="pipeline-layer">
            <div class="pipeline" aria-hidden="true">
              <!-- Harvesting field: 3-row honeycomb -->
              <div class="pipeline__layer pipeline__field">
                <div class="field-row field-row--1">
                  <div class="raw-hex rh--1"></div>
                  <div class="raw-hex rh--2"></div>
                  <div class="raw-hex rh--3"></div>
                  <div class="raw-hex rh--4"></div>
                  <div class="raw-hex rh--5"></div>
                </div>
                <div class="field-row field-row--2">
                  <div class="raw-hex rh--6"></div>
                  <div class="raw-hex rh--7"></div>
                  <div class="raw-hex rh--8"></div>
                  <div class="raw-hex rh--9"></div>
                </div>
                <div class="field-row field-row--3">
                  <div class="raw-hex rh--10"></div>
                  <div class="raw-hex rh--11"></div>
                  <div class="raw-hex rh--12"></div>
                </div>
              </div>

              <!-- Flow: convergence -->
              <svg class="pipeline__flow flow--top" viewBox="0 0 440 55" preserveAspectRatio="none">
                <path d="M60,2 C60,28 220,32 220,52" stroke="rgba(200,169,110,0.18)" stroke-width="1" fill="none" class="flow-line fl--1"/>
                <path d="M130,2 C130,24 220,28 220,52" stroke="rgba(200,169,110,0.24)" stroke-width="1" fill="none" class="flow-line fl--2"/>
                <path d="M220,2 L220,52" stroke="rgba(200,169,110,0.35)" stroke-width="1.5" fill="none" class="flow-line fl--3"/>
                <path d="M310,2 C310,24 220,28 220,52" stroke="rgba(200,169,110,0.24)" stroke-width="1" fill="none" class="flow-line fl--4"/>
                <path d="M380,2 C380,28 220,32 220,52" stroke="rgba(200,169,110,0.18)" stroke-width="1" fill="none" class="flow-line fl--5"/>
              </svg>

              <!-- MCP core -->
              <div class="pipeline__layer pipeline__mcp">
                <div class="mcp-core">
                  <div class="mcp-ring mcp-ring--outer"></div>
                  <div class="mcp-ring mcp-ring--inner"></div>
                  <div class="mcp-center"></div>
                </div>
              </div>

              <!-- Flow: distribution -->
              <svg class="pipeline__flow flow--bottom" viewBox="0 0 440 55" preserveAspectRatio="none">
                <path d="M220,3 C220,28 52,32 52,53" stroke="rgba(200,169,110,0.18)" stroke-width="1" fill="none" class="flow-line fl--6"/>
                <path d="M220,3 C220,24 140,28 140,53" stroke="rgba(200,169,110,0.24)" stroke-width="1" fill="none" class="flow-line fl--7"/>
                <path d="M220,3 L220,53" stroke="rgba(200,169,110,0.35)" stroke-width="1.5" fill="none" class="flow-line fl--8"/>
                <path d="M220,3 C220,24 300,28 300,53" stroke="rgba(200,169,110,0.24)" stroke-width="1" fill="none" class="flow-line fl--9"/>
                <path d="M220,3 C220,28 388,32 388,53" stroke="rgba(200,169,110,0.18)" stroke-width="1" fill="none" class="flow-line fl--10"/>
              </svg>

              <!-- DAG agents -->
              <div class="pipeline__layer pipeline__dag">
                <svg class="dag-connections" viewBox="0 0 440 60" preserveAspectRatio="none">
                  <line x1="72" y1="30" x2="118" y2="30" stroke="rgba(200,169,110,0.12)" stroke-width="1"/>
                  <line x1="162" y1="30" x2="208" y2="30" stroke="rgba(200,169,110,0.12)" stroke-width="1"/>
                  <line x1="252" y1="30" x2="298" y2="30" stroke="rgba(200,169,110,0.12)" stroke-width="1"/>
                  <line x1="342" y1="30" x2="388" y2="30" stroke="rgba(200,169,110,0.12)" stroke-width="1"/>
                  <circle r="3" fill="var(--color-accent)" opacity="0">
                    <animate attributeName="cx" dur="6s" repeatCount="indefinite"
                      values="72;72;118;118;162;162;208;208;252;252;298;298;342;342;388;388;388"
                      keyTimes="0;0.06;0.12;0.18;0.24;0.30;0.36;0.42;0.48;0.54;0.60;0.66;0.72;0.78;0.84;0.94;1" />
                    <animate attributeName="cy" values="30;30;30;30;30;30;30;30;30;30;30;30;30;30;30;30;30" dur="6s" repeatCount="indefinite" />
                    <animate attributeName="opacity" dur="6s" repeatCount="indefinite"
                      values="0;0.8;0.8;0;0;0.8;0.8;0;0;0.8;0.8;0;0;0.8;0.8;0;0"
                      keyTimes="0;0.06;0.11;0.13;0.18;0.24;0.29;0.31;0.36;0.42;0.47;0.49;0.54;0.60;0.65;0.67;1" />
                  </circle>
                  <circle r="2.5" fill="var(--color-accent-hover)" opacity="0">
                    <animate attributeName="cx" dur="6s" repeatCount="indefinite" begin="2s"
                      values="72;72;118;118;162;162;208;208;252;252;298;298;342;342;388;388;388"
                      keyTimes="0;0.06;0.12;0.18;0.24;0.30;0.36;0.42;0.48;0.54;0.60;0.66;0.72;0.78;0.84;0.94;1" />
                    <animate attributeName="cy" values="30;30;30;30;30;30;30;30;30;30;30;30;30;30;30;30;30" dur="6s" repeatCount="indefinite" begin="2s" />
                    <animate attributeName="opacity" dur="6s" repeatCount="indefinite" begin="2s"
                      values="0;0.6;0.6;0;0;0.6;0.6;0;0;0.6;0.6;0;0;0.6;0.6;0;0"
                      keyTimes="0;0.06;0.11;0.13;0.18;0.24;0.29;0.31;0.36;0.42;0.48;0.54;0.60;0.65;0.67;1" />
                  </circle>
                </svg>
                <div class="dag-agent da--1">
                  <svg class="agent-icon" viewBox="0 0 24 24" width="22" height="22"><path d="M10,8 L10,16 M10,8 L14,8 M10,12 L13,12" stroke="var(--color-accent)" stroke-width="1.5" fill="none" stroke-linecap="round"/></svg>
                </div>
                <div class="dag-agent da--2">
                  <svg class="agent-icon" viewBox="0 0 24 24" width="22" height="22"><path d="M8,16 L12,8 L16,16" stroke="var(--color-accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="dag-agent da--3">
                  <svg class="agent-icon" viewBox="0 0 24 24" width="22" height="22"><rect x="7" y="7" width="10" height="10" rx="2" stroke="var(--color-accent)" stroke-width="1.5" fill="none"/></svg>
                </div>
                <div class="dag-agent da--4">
                  <svg class="agent-icon" viewBox="0 0 24 24" width="22" height="22"><path d="M8,12 L11,15 L16,9" stroke="var(--color-accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
                <div class="dag-agent da--5">
                  <svg class="agent-icon" viewBox="0 0 24 24" width="22" height="22"><path d="M8,12 L16,12 M13,9 L16,12 L13,15" stroke="var(--color-accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Layer 2: Logo overlay (on top, breathes in/out) -->
          <div class="logo-overlay">
            <div class="logo-overlay__bg"></div>
            <img
              src="/images/ConatusREIcon500-300x300.png"
              alt="Conatus Real Estate"
              class="logo-overlay__img"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Built with Claude -->
  <section class="section claude-section" id="claude">
    <div class="container">
      <div class="claude-grid">
        <div class="claude-content" data-animate>
          <p class="section-header__label">AI-Native Development</p>
          <h2>Built with <span class="accent">Claude</span></h2>
          <p class="claude-lead">
            Every platform we build leverages Claude's intelligence — not as an add-on,
            but as core infrastructure. MCP tool definitions, autonomous agent workflows,
            and AI-driven analysis pipelines are how we work.
          </p>
          <ul class="claude-capabilities">
            <li>
              <span class="claude-capabilities__icon" aria-hidden="true">{'\u25B8'}</span>
              <span><strong>MCP Integration</strong> — Custom tool definitions that give Claude structured access to your operational data</span>
            </li>
            <li>
              <span class="claude-capabilities__icon" aria-hidden="true">{'\u25B8'}</span>
              <span><strong>Autonomous Agents</strong> — Multi-step workflows that execute complex analysis and development tasks</span>
            </li>
            <li>
              <span class="claude-capabilities__icon" aria-hidden="true">{'\u25B8'}</span>
              <span><strong>Production Systems</strong> — Not prototypes — purpose-built platforms designed for real operations at scale</span>
            </li>
          </ul>
        </div>
        <div class="claude-diagram" data-animate>
          <div class="diagram-window">
            <div class="diagram-window__header">
              <span class="diagram-window__dot"></span>
              <span class="diagram-window__dot"></span>
              <span class="diagram-window__dot"></span>
              <span class="diagram-window__title">AI Platform Architecture</span>
            </div>
            <div class="diagram-window__body">
              <svg class="workflow-svg" viewBox="0 0 440 380" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Data Sources row -->
                <rect x="20" y="20" width="120" height="50" rx="8" stroke="var(--color-accent)" stroke-width="1" fill="rgba(200,169,110,0.06)" />
                <text x="80" y="40" text-anchor="middle" fill="var(--color-text)" font-size="11" font-family="var(--font-body)">Data Sources</text>
                <text x="80" y="55" text-anchor="middle" fill="var(--color-text-muted)" font-size="9" font-family="var(--font-mono)">APIs · DBs · Feeds</text>

                <rect x="160" y="20" width="120" height="50" rx="8" stroke="var(--color-border)" stroke-width="1" fill="rgba(200,169,110,0.03)" />
                <text x="220" y="40" text-anchor="middle" fill="var(--color-text)" font-size="11" font-family="var(--font-body)">Documents</text>
                <text x="220" y="55" text-anchor="middle" fill="var(--color-text-muted)" font-size="9" font-family="var(--font-mono)">PDFs · Contracts</text>

                <rect x="300" y="20" width="120" height="50" rx="8" stroke="var(--color-border)" stroke-width="1" fill="rgba(200,169,110,0.03)" />
                <text x="360" y="40" text-anchor="middle" fill="var(--color-text)" font-size="11" font-family="var(--font-body)">Live Feeds</text>
                <text x="360" y="55" text-anchor="middle" fill="var(--color-text-muted)" font-size="9" font-family="var(--font-mono)">MLS · Markets</text>

                <!-- Arrows down to RAG -->
                <line x1="80" y1="70" x2="220" y2="110" stroke="rgba(200,169,110,0.3)" stroke-width="1" />
                <line x1="220" y1="70" x2="220" y2="110" stroke="rgba(200,169,110,0.3)" stroke-width="1" />
                <line x1="360" y1="70" x2="220" y2="110" stroke="rgba(200,169,110,0.3)" stroke-width="1" />

                <!-- RAG Layer -->
                <rect x="120" y="110" width="200" height="55" rx="8" stroke="var(--color-accent)" stroke-width="1.5" fill="rgba(200,169,110,0.08)" />
                <text x="220" y="132" text-anchor="middle" fill="var(--color-accent)" font-size="12" font-weight="600" font-family="var(--font-body)">RAG Pipeline</text>
                <text x="220" y="150" text-anchor="middle" fill="var(--color-text-muted)" font-size="9" font-family="var(--font-mono)">Embed · Index · Retrieve</text>

                <!-- Arrow down to Claude -->
                <line x1="220" y1="165" x2="220" y2="195" stroke="rgba(200,169,110,0.4)" stroke-width="1.5" />
                <polygon points="215,193 220,200 225,193" fill="var(--color-accent)" opacity="0.5" />

                <!-- Claude / MCP Core -->
                <rect x="80" y="200" width="280" height="65" rx="10" stroke="var(--color-accent)" stroke-width="2" fill="rgba(200,169,110,0.1)" />
                <text x="220" y="224" text-anchor="middle" fill="var(--color-accent)" font-size="13" font-weight="700" font-family="var(--font-body)">Claude + MCP Tools</text>
                <text x="220" y="245" text-anchor="middle" fill="var(--color-text-muted)" font-size="9" font-family="var(--font-mono)">Analyze · Decide · Execute · Report</text>

                <!-- DAG branches -->
                <line x1="140" y1="265" x2="80" y2="305" stroke="rgba(200,169,110,0.3)" stroke-width="1" />
                <polygon points="76,301 80,310 85,303" fill="var(--color-accent)" opacity="0.4" />
                <line x1="220" y1="265" x2="220" y2="305" stroke="rgba(200,169,110,0.3)" stroke-width="1" />
                <polygon points="215,303 220,310 225,303" fill="var(--color-accent)" opacity="0.4" />
                <line x1="300" y1="265" x2="360" y2="305" stroke="rgba(200,169,110,0.3)" stroke-width="1" />
                <polygon points="355,303 360,310 364,301" fill="var(--color-accent)" opacity="0.4" />

                <!-- Output DAG nodes -->
                <rect x="20" y="310" width="120" height="50" rx="8" stroke="var(--color-border)" stroke-width="1" fill="rgba(200,169,110,0.04)" />
                <text x="80" y="332" text-anchor="middle" fill="var(--color-text)" font-size="10" font-family="var(--font-body)">Underwriting</text>
                <text x="80" y="347" text-anchor="middle" fill="var(--color-text-muted)" font-size="8" font-family="var(--font-mono)">Screen · Score · Offer</text>

                <rect x="160" y="310" width="120" height="50" rx="8" stroke="var(--color-border)" stroke-width="1" fill="rgba(200,169,110,0.04)" />
                <text x="220" y="332" text-anchor="middle" fill="var(--color-text)" font-size="10" font-family="var(--font-body)">Asset Mgmt</text>
                <text x="220" y="347" text-anchor="middle" fill="var(--color-text-muted)" font-size="8" font-family="var(--font-mono)">Lease · Inspect · Report</text>

                <rect x="300" y="310" width="120" height="50" rx="8" stroke="var(--color-border)" stroke-width="1" fill="rgba(200,169,110,0.04)" />
                <text x="360" y="332" text-anchor="middle" fill="var(--color-text)" font-size="10" font-family="var(--font-body)">Analytics</text>
                <text x="360" y="347" text-anchor="middle" fill="var(--color-text-muted)" font-size="8" font-family="var(--font-mono)">Dash · Alerts · Insights</text>

                <!-- DAG label -->
                <text x="435" y="340" text-anchor="end" fill="var(--color-accent)" font-size="9" font-family="var(--font-mono)" opacity="0.6">DAG</text>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof Points -->
  <section class="section proof-section">
    <div class="container">
      <div class="proof-grid" data-animate>
        <div class="proof-card">
          <span class="proof-card__number">4,000+</span>
          <span class="proof-card__label">SFR Transactions Executed</span>
          <span class="proof-card__detail">Through platforms we built and operated</span>
        </div>
        <div class="proof-card">
          <span class="proof-card__number">$1B+</span>
          <span class="proof-card__label">In SFR Acquisitions</span>
          <span class="proof-card__detail">As operator, not advisor — the requirements don't come from interviews</span>
        </div>
        <div class="proof-card">
          <span class="proof-card__number">AI-Native</span>
          <span class="proof-card__label">Built with Claude</span>
          <span class="proof-card__detail">Every platform leverages Claude's intelligence</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-header" data-animate>
        <p class="section-header__label">What We Build</p>
        <h2>Your Platform, Not Theirs</h2>
        <p class="section-intro">Designed by someone who's run the operations you need to automate. These aren't services a generalist shop can offer — they require understanding the domain from the inside out.</p>
      </div>
      <div class="services-grid">
        <div class="card service-card" data-animate>
          <span class="service-icon">01</span>
          <h3>Operational Platform Development</h3>
          <p>Custom software platforms built for regulated operations — purpose-built tools that execute at scale, not SaaS products that solve half your problems.</p>
          <ul class="service-features">
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Requirements Analysis & Architecture</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Full-Stack Platform Engineering</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Data Pipeline & Integration</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Production Deployment & Monitoring</li>
          </ul>
        </div>
        <div class="card service-card" data-animate>
          <span class="service-icon">02</span>
          <h3>Claude Integration</h3>
          <p>Put the intelligence of Claude inside your existing platform. MCP integrations, autonomous workflows, and AI-native tools that amplify your team.</p>
          <ul class="service-features">
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> MCP Tool Definitions</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Autonomous Agent Workflows</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> AI-Powered Document Processing</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Intelligent Analytics Pipelines</li>
          </ul>
        </div>
        <div class="card service-card" data-animate>
          <span class="service-icon">03</span>
          <h3>Operational Analytics & Technical Consulting</h3>
          <p>Data infrastructure, analytics pipelines, and technical strategy for operators who need to make faster, better-informed decisions.</p>
          <ul class="service-features">
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Data Infrastructure Design</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Portfolio Dashboards & Reporting</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Technical Strategy & Architecture</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Implementation Oversight</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  {allCaseStudies.length > 0 && (
    <section class="section" id="case-studies">
      <div class="container">
        <div class="section-header" data-animate>
          <p class="section-header__label">Platforms We've Built</p>
          <h2>Case Studies</h2>
        </div>
        <div class="grid grid--3">
          {allCaseStudies.map((study) => (
            <div data-animate>
              <CaseStudyCard
                title={study.data.title}
                description={study.data.description}
                slug={study.id}
                propertyType={study.data.propertyType}
                market={study.data.market}
                outcome={study.data.outcome}
              />
            </div>
          ))}
        </div>
        <div class="section-footer" data-animate>
          <a href="/case-studies" class="btn btn--outline">View All Case Studies</a>
        </div>
      </div>
    </section>
  )}

  <!-- Domain Expertise -->
  <section class="section domain-section">
    <div class="container">
      <div class="section-header" data-animate>
        <p class="section-header__label">Domain Expertise</p>
        <h2>Regulated Industries, Starting with Real Estate</h2>
      </div>
      <div class="domain-grid" data-animate>
        <div class="domain-card domain-card--primary">
          <h3>Single-Family Residential</h3>
          <p>Our deepest domain. Acquisitions, asset management, HCV operations, compliance — we've built and operated at every level of the SFR stack.</p>
        </div>
        <div class="domain-card">
          <h3>Financial Services</h3>
          <p>Portfolio analytics, risk assessment, and compliance automation for asset managers and investment firms.</p>
        </div>
        <div class="domain-card">
          <h3>Private Lending</h3>
          <p>Loan origination workflows, underwriting automation, and portfolio monitoring platforms.</p>
        </div>
        <div class="domain-card">
          <h3>Asset Management</h3>
          <p>Deep experience managing single-family residential portfolios — lease-ups, HCV compliance, inspections, and housing authority coordination. Applying the same platform approach to broader asset classes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- The Platform -->
  <section class="section platform-section">
    <div class="container">
      <div class="section-header" data-animate>
        <p class="section-header__label">The Platform</p>
        <h2>What We've Built & Where We Operate</h2>
      </div>
      <div class="platform-grid" data-animate>
        <div class="card platform-card">
          <span class="platform-tag">Acquisitions</span>
          <h3>Fortune Acquisitions</h3>
          <p>Execution-first, institutional-grade real estate acquisition platform. Systematically sources live acquisition leads, enriches every record, and delivers a purpose-built underwriting environment with automated offer submission.</p>
          <a href="https://fortuneacquisitions.com" class="btn btn--outline btn--sm" target="_blank" rel="noopener">Fortune Acquisitions &rarr;</a>
        </div>
        <div class="card platform-card">
          <span class="platform-tag">1031 Exchange</span>
          <h3>1031 Exchange Consulting</h3>
          <p>Strategic consulting for investors executing 1031 exchanges within the single-family residential space, including identification, analysis, and acquisition support.</p>
          <a href="/contact" class="btn btn--outline btn--sm">Inquire &rarr;</a>
        </div>
        <div class="card platform-card">
          <span class="platform-tag">Consulting</span>
          <h3>Ops & Tech Consulting</h3>
          <p>Operational analytics, technical strategy, and AI integration consulting for regulated industries. We help operators build the infrastructure their business actually needs.</p>
