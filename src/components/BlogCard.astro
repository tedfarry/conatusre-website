---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  category?: string;
  heroImage?: string;
}

const { title, description, pubDate, slug, category, heroImage } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={`/blog/${slug}`} class="blog-card card">
  {heroImage && (
    <div class="blog-card__image">
      <img src={heroImage} alt={title} loading="lazy" />
    </div>
  )}
  <div class="blog-card__content">
    <div class="blog-card__meta">
      {category && <span class="tag">{category}</span>}
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <h3 class="blog-card__title">{title}</h3>
    <p class="blog-card__description">{description}</p>
  </div>
</a>

<style>
  .blog-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    overflow: hidden;
    height: 100%;
  }

  .blog-card__image {
    margin: calc(-1 * var(--space-lg));
    margin-bottom: var(--space-md);
  }

  .blog-card__image img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .blog-card__content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .blog-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .blog-card__meta time {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .blog-card__title {
    font-size: 1.15rem;
    color: var(--color-text);
    margin-bottom: var(--space-sm);
  }

  .blog-card__description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
    margin-top: auto;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
</style>
