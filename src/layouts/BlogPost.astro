---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  category?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, heroImage, category, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updatedDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description} image={heroImage} type="article" pubDate={pubDate}>
  <article class="blog-post section">
    <div class="container--narrow">
      <header class="blog-post__header">
        <div class="blog-post__meta">
          {category && <span class="tag">{category}</span>}
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {formattedUpdated && <span class="blog-post__updated">(Updated {formattedUpdated})</span>}
        </div>
        <h1>{title}</h1>
        <p class="blog-post__description">{description}</p>
        {tags.length > 0 && (
          <div class="blog-post__tags">
            {tags.map((tag) => <span class="tag">{tag}</span>)}
          </div>
        )}
      </header>

      {heroImage && (
        <div class="blog-post__hero">
          <img src={heroImage} alt={title} />
        </div>
      )}

      <div class="prose">
        <slot />
      </div>

      <div class="blog-disclaimer">
        <p>
          The information in this article is for educational purposes only and does not
          constitute tax, legal, financial, or investment advice. Consult a qualified
          professional before making investment decisions.
        </p>
      </div>

      <footer class="blog-post__footer">
        <a href="/blog" class="btn btn--outline">&larr; Back to Blog</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .blog-post__header {
    margin-bottom: var(--space-xl);
  }

  .blog-post__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .blog-post__meta time {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .blog-post__updated {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .blog-post__header h1 {
    margin-bottom: var(--space-sm);
  }

  .blog-post__description {
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  .blog-post__tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-md);
  }

  .blog-post__hero {
    margin-bottom: var(--space-xl);
  }

  .blog-post__hero img {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .blog-disclaimer {
    margin-top: var(--space-xl);
    padding: var(--space-md);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .blog-disclaimer p {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
    font-style: italic;
  }

  .blog-post__footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }
</style>
