---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  heroImage?: string;
  propertyType: string;
  market: string;
  outcome: string;
  tags?: string[];
}

const { title, description, pubDate, heroImage, propertyType, market, outcome, tags = [] } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={title} description={description} image={heroImage} type="article" pubDate={pubDate}>
  <article class="case-study section">
    <div class="container--narrow">
      <header class="case-study__header">
        <div class="case-study__meta">
          <span class="tag">{propertyType}</span>
          <span class="case-study__market">{market}</span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        </div>
        <h1>{title}</h1>
        <p class="case-study__description">{description}</p>
      </header>

      <!-- Quick facts sidebar -->
      <div class="case-study__facts">
        <div class="case-study__fact">
          <span class="case-study__fact-label">Property Type</span>
          <span class="case-study__fact-value">{propertyType}</span>
        </div>
        <div class="case-study__fact">
          <span class="case-study__fact-label">Market</span>
          <span class="case-study__fact-value">{market}</span>
        </div>
        <div class="case-study__fact">
          <span class="case-study__fact-label">Outcome</span>
          <span class="case-study__fact-value accent">{outcome}</span>
        </div>
      </div>

      {heroImage && (
        <div class="case-study__hero">
          <img src={heroImage} alt={title} />
        </div>
      )}

      <!-- Case study body: problem / process / outcome narrative -->
      <div class="prose">
        <slot />
      </div>

      {tags.length > 0 && (
        <div class="case-study__tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}

      <footer class="case-study__footer">
        <a href="/case-studies" class="btn btn--outline">&larr; All Case Studies</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .case-study__header {
    margin-bottom: var(--space-lg);
  }

  .case-study__meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .case-study__market,
  .case-study__meta time {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .case-study__header h1 {
    margin-bottom: var(--space-sm);
  }

  .case-study__description {
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  .case-study__facts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .case-study__fact {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .case-study__fact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .case-study__fact-value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .case-study__hero {
    margin-bottom: var(--space-xl);
  }

  .case-study__hero img {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .case-study__tags {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }

  .case-study__footer {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 640px) {
    .case-study__facts {
      grid-template-columns: 1fr;
    }
  }
</style>
