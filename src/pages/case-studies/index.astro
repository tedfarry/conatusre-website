---
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const allStudies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base
  title="Case Studies"
  description="Real-world examples of how Conatus Real Estate Inc. applies technology and operational rigor to single-family residential investments."
>
  <section class="section">
    <div class="container">
      <div class="page-header">
        <p class="page-label">Our Work</p>
        <h1>Case Studies</h1>
        <p class="page-description">
          Real-world examples of our approach in action. Each case study follows
          a problem / process / outcome narrative to show how we work.
        </p>
      </div>

      <div class="studies-grid">
        {allStudies.map((study) => (
          <CaseStudyCard
            title={study.data.title}
            description={study.data.description}
            slug={study.id}
            propertyType={study.data.propertyType}
            market={study.data.market}
            outcome={study.data.outcome}
          />
        ))}
      </div>

      {allStudies.length === 0 && (
        <p class="empty-state">No case studies yet. Check back soon.</p>
      )}
    </div>
  </section>
</Base>

<style>
  .page-header {
    margin-bottom: var(--space-xl);
    max-width: 560px;
  }

  .page-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  .page-description {
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .studies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: var(--space-lg);
  }

  .empty-state {
    text-align: center;
    color: var(--color-text-muted);
    padding: var(--space-2xl);
  }
</style>
