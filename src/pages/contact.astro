---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact"
  description="Get in touch with Conatus Real Estate for consulting, partnership opportunities, or general inquiries."
>
  <section class="section">
    <div class="container--narrow">
      <p class="page-label">Contact</p>
      <h1>Let's <span class="accent">talk</span></h1>

      <div class="prose">
        <p class="lead">
          Whether you're looking to build a new operations platform, integrate AI into
          existing systems, or need technical consulting — we'd like to hear from you.
        </p>
      </div>

      <div class="contact-options">
        <div class="card">
          <h3>Email</h3>
          <p>For inquiries and consulting engagements.</p>
          <a href="mailto:houses@conatusre.com" class="btn btn--outline">houses@conatusre.com</a>
        </div>

        <div class="card">
          <h3>Phone</h3>
          <p>Call us directly to discuss your project.</p>
          <a href="tel:+19492673990" class="btn btn--outline">(949) 267-3990</a>
        </div>

        <div class="card">
          <h3>Office</h3>
          <p>5000 Birch Street, Suite 3000<br />Newport Beach, CA 92660</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .page-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }

  h1 {
    margin-bottom: var(--space-xl);
  }

  .lead {
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  .contact-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }
</style>
