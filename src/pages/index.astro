  }

  .btn--sm {
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
  }

  /* ========================
     CTA Section
     ======================== */
  .cta-section {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    position: relative;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0.3;
  }

  .cta-content {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .cta-content h2 {
    margin-bottom: var(--space-md);
