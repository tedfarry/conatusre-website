---
import Base from '../layouts/Base.astro';
import BlogCard from '../components/BlogCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allCaseStudies = (await getCollection('case-studies', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

---

<Base
  title="Conatus Real Estate — AI-Powered Operations Platforms"
  description="Custom AI-powered operations platforms for regulated industries — not SaaS, not off-the-shelf. 4,000+ SFR transactions, $1B+ in acquisitions capital. Deep operational expertise. Built with Claude."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero__content" data-animate>
        <p class="hero__label">AI-Powered Operations</p>
        <h1 class="hero__title">
          We build the systems.<br />
          <span class="accent">We know the domain.</span>
        </h1>
        <p class="hero__subtitle">
          Fully custom operations platforms — not SaaS products that solve half your problems
          and a thousand that aren't yours. Built by operators with deep domain expertise,
          powered by AI. Starting with single-family residential real estate and expanding
          across financial services, asset management, and private lending.
        </p>
        <div class="hero__actions">
          <a href="/contact" class="btn btn--primary">Get in Touch</a>
          <a href="#case-studies" class="btn btn--outline">See Our Work</a>
        </div>
      </div>
      <div class="hero__visual" data-animate>
        <div class="hero__brand-display">
          <div class="hero__brand-ring"></div>
          <div class="hero__brand-glow"></div>
          <img
            src="/assets/brand/ConatusREIcon500-300x300.png"
            alt="Conatus Real Estate"
            class="hero__brand-mark"
            width="180"
            height="180"
          />
        </div>
        <p class="hero__brand-name">Conatus Real Estate Inc.</p>
      </div>
    </div>
  </section>

  <!-- Built with Claude -->
  <section class="section claude-section" id="claude">
    <div class="container">
      <div class="claude-grid">
        <div class="claude-content" data-animate>
          <p class="section-header__label">AI-Native Development</p>
          <h2>Built with <span class="accent">Claude</span></h2>
          <p class="claude-lead">
            Every platform we build leverages Claude's intelligence — not as an add-on,
            but as core infrastructure. MCP tool definitions, autonomous agent workflows,
            and AI-driven analysis pipelines are how we work.
          </p>
          <ul class="claude-capabilities">
            <li>
              <span class="claude-capabilities__icon" aria-hidden="true">{'\u25B8'}</span>
              <span><strong>MCP Integration</strong> — Custom tool definitions that give Claude structured access to your operational data</span>
            </li>
            <li>
              <span class="claude-capabilities__icon" aria-hidden="true">{'\u25B8'}</span>
              <span><strong>Autonomous Agents</strong> — Multi-step workflows that execute complex analysis and development tasks</span>
            </li>
            <li>
              <span class="claude-capabilities__icon" aria-hidden="true">{'\u25B8'}</span>
              <span><strong>Production Systems</strong> — Not prototypes — purpose-built platforms designed for real operations at scale</span>
            </li>
          </ul>
        </div>
        <div class="claude-code" data-animate>
          <div class="code-window">
            <div class="code-window__header">
              <span class="code-window__dot"></span>
              <span class="code-window__dot"></span>
              <span class="code-window__dot"></span>
              <span class="code-window__title">acquisition_screen.py</span>
            </div>
            <pre class="code-window__body"><code set:html={`<span class="code-kw">from</span> <span class="code-mod">fastmcp</span> <span class="code-kw">import</span> FastMCP
<span class="code-kw">from</span> <span class="code-mod">pydantic</span> <span class="code-kw">import</span> BaseModel

mcp = FastMCP(<span class="code-str">"conatus-ops"</span>)

<span class="code-kw">class</span> <span class="code-type">Deal</span>(BaseModel):
    asking: <span class="code-type">float</span>
    arv: <span class="code-type">float</span>
    monthly_rent: <span class="code-type">float</span>
    rehab: <span class="code-type">float</span> = <span class="code-num">0.0</span>

<span class="code-decorator">@mcp.tool()</span>
<span class="code-kw">def</span> <span class="code-fn">screen_acquisition</span>(deal: <span class="code-type">Deal</span>) -&gt; <span class="code-type">dict</span>:
    <span class="code-str">"""Screen a potential SFR acquisition
    against portfolio investment criteria."""</span>
    max_offer = deal.arv * <span class="code-num">0.70</span> - deal.rehab
    cap = (deal.monthly_rent * <span class="code-num">12</span>) / deal.arv
    coc = (deal.monthly_rent * <span class="code-num">12</span>) / (
        deal.asking + deal.rehab
    )
    <span class="code-kw">return</span> {
        <span class="code-str">"max_offer"</span>: <span class="code-fn">round</span>(max_offer, <span class="code-num">2</span>),
        <span class="code-str">"cap_rate"</span>: <span class="code-fn">round</span>(cap, <span class="code-num">4</span>),
        <span class="code-str">"cash_on_cash"</span>: <span class="code-fn">round</span>(coc, <span class="code-num">4</span>),
        <span class="code-str">"meets_criteria"</span>: cap &gt;= <span class="code-num">0.08</span>
            <span class="code-kw">and</span> max_offer &gt;= deal.asking,
    }`} /></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Proof Points -->
  <section class="section proof-section">
    <div class="container">
      <div class="proof-grid" data-animate>
        <div class="proof-card">
          <span class="proof-card__number">4,000+</span>
          <span class="proof-card__label">SFR Transactions Executed</span>
          <span class="proof-card__detail">Through platforms we built and operated</span>
        </div>
        <div class="proof-card">
          <span class="proof-card__number">$1B+</span>
          <span class="proof-card__label">In SFR Transactions</span>
          <span class="proof-card__detail">Systematic, data-driven processes at scale</span>
        </div>
        <div class="proof-card">
          <span class="proof-card__number">AI-Native</span>
          <span class="proof-card__label">Built with Claude</span>
          <span class="proof-card__detail">Every platform leverages Claude's intelligence</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-header" data-animate>
        <p class="section-header__label">What We Build</p>
        <h2>Your Platform, Not Theirs</h2>
      </div>
      <div class="services-grid">
        <div class="card service-card" data-animate>
          <span class="service-icon">01</span>
          <h3>Operational Platform Development</h3>
          <p>Custom software platforms built for regulated operations — purpose-built tools that execute at scale, not SaaS products that solve half your problems.</p>
          <ul class="service-features">
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Requirements Analysis & Architecture</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Full-Stack Platform Engineering</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Data Pipeline & Integration</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Production Deployment & Monitoring</li>
          </ul>
        </div>
        <div class="card service-card" data-animate>
          <span class="service-icon">02</span>
          <h3>Claude Integration</h3>
          <p>Put the intelligence of Claude inside your existing platform. MCP integrations, autonomous workflows, and AI-native tools that amplify your team.</p>
          <ul class="service-features">
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> MCP Tool Definitions</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Autonomous Agent Workflows</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> AI-Powered Document Processing</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Intelligent Analytics Pipelines</li>
          </ul>
        </div>
        <div class="card service-card" data-animate>
          <span class="service-icon">03</span>
          <h3>Operational Analytics & Technical Consulting</h3>
          <p>Data infrastructure, analytics pipelines, and technical strategy for operators who need to make faster, better-informed decisions.</p>
          <ul class="service-features">
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Data Infrastructure Design</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Portfolio Dashboards & Reporting</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Technical Strategy & Architecture</li>
            <li><span class="feature-arrow" aria-hidden="true">&#x25B8;</span> Implementation Oversight</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  {allCaseStudies.length > 0 && (
    <section class="section" id="case-studies">
      <div class="container">
        <div class="section-header" data-animate>
          <p class="section-header__label">Platforms We've Built</p>
          <h2>Case Studies</h2>
        </div>
        <div class="grid grid--3">
          {allCaseStudies.map((study) => (
            <div data-animate>
              <CaseStudyCard
                title={study.data.title}
                description={study.data.description}
                slug={study.id}
                propertyType={study.data.propertyType}
                market={study.data.market}
                outcome={study.data.outcome}
              />
            </div>
          ))}
        </div>
        <div class="section-footer" data-animate>
          <a href="/case-studies" class="btn btn--outline">View All Case Studies</a>
        </div>
      </div>
    </section>
  )}

  <!-- Domain Expertise -->
  <section class="section domain-section">
    <div class="container">
      <div class="section-header" data-animate>
        <p class="section-header__label">Domain Expertise</p>
        <h2>Regulated Industries, Starting with Real Estate</h2>
      </div>
      <div class="domain-grid" data-animate>
        <div class="domain-card domain-card--primary">
          <h3>Single-Family Residential</h3>
          <p>Our deepest domain. Acquisitions, asset management, HCV operations, compliance — we've built and operated at every level of the SFR stack.</p>
        </div>
        <div class="domain-card">
          <h3>Financial Services</h3>
          <p>Portfolio analytics, risk assessment, and compliance automation for asset managers and investment firms.</p>
        </div>
        <div class="domain-card">
          <h3>Private Lending</h3>
          <p>Loan origination workflows, underwriting automation, and portfolio monitoring platforms.</p>
        </div>
        <div class="domain-card">
          <h3>Asset Management</h3>
          <p>Deep experience managing SFR portfolios — lease-ups, HCV compliance, inspections, and housing authority coordination. Platform-ready for broader asset classes.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Existing Clients & Investors -->
  <section class="section legacy-section">
    <div class="container">
      <div class="section-header" data-animate>
        <p class="section-header__label">Existing Clients & Investors</p>
        <h2>Investment & Advisory</h2>
      </div>
      <div class="legacy-grid" data-animate>
        <div class="card legacy-card">
          <h3>Homestead Affordable Fund I</h3>
          <p>Conatus Real Estate Inc. is the sponsor of Homestead Affordable Fund I, a single-family residential fund focused on Housing Choice Voucher tenants.</p>
          <a href="https://homesteadaffordable.com" class="btn btn--outline btn--sm" target="_blank" rel="noopener">Homestead Affordable &rarr;</a>
        </div>
        <div class="card legacy-card">
          <h3>1031 Exchange Consulting</h3>
          <p>We provide strategic consulting for investors executing 1031 exchanges within the single-family residential space, including identification, analysis, and acquisition support.</p>
          <a href="/contact" class="btn btn--outline btn--sm">Inquire &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog -->
  {allPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header" data-animate>
          <p class="section-header__label">Insights</p>
          <h2>Latest from the Blog</h2>
        </div>
        <div class="grid grid--3">
          {allPosts.map((post) => (
            <div data-animate>
              <BlogCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                slug={post.id}
                category={post.data.category}
                heroImage={post.data.heroImage}
              />
            </div>
          ))}
        </div>
        <div class="section-footer" data-animate>
          <a href="/blog" class="btn btn--outline">View All Posts</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="section cta-section">
    <div class="container">
      <div class="cta-content" data-animate>
        <h2>Ready to build?</h2>
        <p class="cta-lead">
          Whether you need a custom operations platform, want to put the intelligence of
          Claude inside your existing systems, or need operational analytics consulting
          — let's talk.
        </p>
        <div class="cta-contact">
          <div class="cta-contact__item">
            <span class="cta-contact__label">Email</span>
            <a href="mailto:houses@conatusre.com">houses@conatusre.com</a>
          </div>
          <div class="cta-contact__item">
            <span class="cta-contact__label">Phone</span>
            <a href="tel:+19492673990">(949) 267-3990</a>
          </div>
          <div class="cta-contact__item">
            <span class="cta-contact__label">Office</span>
            <span class="cta-contact__text">5000 Birch Street, Suite 3000<br />Newport Beach, CA 92660</span>
          </div>
        </div>
        <div class="cta-actions">
          <a href="/contact" class="btn btn--primary">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ========================
     Hero
     ======================== */
  .hero {
    padding: var(--space-2xl) 0;
    min-height: 85vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse 80% 60% at 70% 40%, rgba(200, 169, 110, 0.04) 0%, transparent 70%);
  }

  .hero > .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .hero__content {
    max-width: 640px;
  }

  .hero__label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-md);
    font-weight: 500;
  }

  .hero__title {
    margin-bottom: var(--space-lg);
    line-height: 1.1;
  }

  .hero__subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    max-width: 540px;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  /* Hero brand visual */
  .hero__visual {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero__brand-display {
    position: relative;
    width: 260px;
    height: 260px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero__brand-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgba(200, 169, 110, 0.25);
    animation: ring-pulse 4s ease-in-out infinite;
  }

  .hero__brand-ring::before {
    content: '';
    position: absolute;
    inset: -20px;
    border-radius: 50%;
    border: 1px solid rgba(200, 169, 110, 0.1);
  }

  .hero__brand-ring::after {
    content: '';
    position: absolute;
    inset: 16px;
    border-radius: 50%;
    border: 1px solid rgba(200, 169, 110, 0.15);
  }

  @keyframes ring-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.03); }
  }

  .hero__brand-glow {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 169, 110, 0.15) 0%, transparent 70%);
    filter: blur(30px);
  }

  .hero__brand-mark {
    position: relative;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    object-fit: contain;
    filter: drop-shadow(0 0 40px rgba(200, 169, 110, 0.2));
  }

  .hero__brand-name {
    font-family: var(--font-heading);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-text-muted);
    text-align: center;
  }

  @media (max-width: 768px) {
    .hero > .container {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: -1;
    }

    .hero__brand-display {
      width: 180px;
      height: 180px;
    }

    .hero__brand-mark {
      width: 120px;
      height: 120px;
    }

    .hero__brand-glow {
      width: 140px;
      height: 140px;
    }

    .hero {
      min-height: auto;
      padding: var(--space-xl) 0 var(--space-2xl);
    }
  }

  /* ========================
     Section utilities
     ======================== */
  .section-header {
    margin-bottom: var(--space-xl);
  }

  .section-header__label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    font-weight: 500;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-lg);
  }

  .service-card h3 {
    margin-bottom: var(--space-sm);
  }

  .service-card > p {
    font-size: 0.9rem;
    margin-bottom: var(--space-md);
  }

  .service-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
    padding: 0;
  }

  .service-features li {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .feature-arrow {
    color: var(--color-accent);
    font-size: 0.7rem;
    flex-shrink: 0;
  }

  .service-icon {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--color-accent);
    margin-bottom: var(--space-sm);
    display: block;
    letter-spacing: 0.05em;
  }

  .grid {
    display: grid;
    gap: var(--space-lg);
  }

  .grid--3 {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  .section-footer {
    margin-top: var(--space-xl);
    text-align: center;
  }

  /* ========================
     Built with Claude
     ======================== */
  .claude-section {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
  }

  .claude-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .claude-lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
    line-height: 1.7;
  }

  .claude-capabilities {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .claude-capabilities li {
    display: flex;
    gap: var(--space-sm);
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .claude-capabilities__icon {
    color: var(--color-accent);
    flex-shrink: 0;
    margin-top: 0.2em;
  }

  .claude-capabilities strong {
    color: var(--color-text);
  }

  /* Code window */
  .code-window {
    background: #0d0d0d;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }

  .code-window__header {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--color-border);
  }

  .code-window__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .code-window__title {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .code-window__body {
    padding: 20px;
    margin: 0;
    background: none;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .code-window__body code {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .code-kw { color: #c8a96e; }
  .code-fn { color: #7ec8a4; }
  .code-str { color: #8bbf6e; }
  .code-mod { color: #d4ba82; }
  .code-type { color: #7ea8c8; }
  .code-num { color: #d4a06e; }
  .code-decorator { color: #c8a96e; opacity: 0.8; }

  @media (max-width: 900px) {
    .claude-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ========================
     Proof Points
     ======================== */
  .proof-section {
    padding: var(--space-xl) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    text-align: center;
  }

  .proof-card {
    padding: var(--space-lg);
    position: relative;
  }

  .proof-card + .proof-card::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: var(--color-border);
  }

  .proof-card__number {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-xs);
  }

  .proof-card__label {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .proof-card__detail {
    display: block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .proof-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .proof-card + .proof-card::before {
      left: 20%;
      right: 20%;
      top: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }
  }

  /* ========================
     Domain Expertise
     ======================== */
