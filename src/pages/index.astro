  }

  .rh--1  { background: linear-gradient(160deg, var(--color-accent) 0%, #a08550 100%); }
  .rh--2  { background: linear-gradient(160deg, var(--color-accent-hover) 0%, var(--color-accent) 100%); }
  .rh--3  { background: linear-gradient(160deg, #a08550 0%, #7a6540 100%); }
  .rh--4  { background: linear-gradient(160deg, var(--color-accent) 0%, var(--color-accent-hover) 100%); }
  .rh--5  { background: linear-gradient(160deg, #7a6540 0%, var(--color-accent) 100%); }
  .rh--6  { background: linear-gradient(160deg, var(--color-accent-hover) 0%, #a08550 100%); }
  .rh--7  { background: linear-gradient(160deg, var(--color-accent) 0%, #7a6540 100%); }
  .rh--8  { background: linear-gradient(160deg, #a08550 0%, var(--color-accent-hover) 100%); }
  .rh--9  { background: linear-gradient(160deg, #7a6540 0%, var(--color-accent) 100%); }
  .rh--10 { background: linear-gradient(160deg, var(--color-accent) 0%, #a08550 100%); }
  .rh--11 { background: linear-gradient(160deg, var(--color-accent-hover) 0%, #7a6540 100%); }
  .rh--12 { background: linear-gradient(160deg, #a08550 0%, var(--color-accent) 100%); }

  .rh--1  { animation: harvest-pulse 3.5s ease-in-out 0.0s infinite; --base-o: 0.55; }
  .rh--2  { animation: harvest-pulse 3.5s ease-in-out 0.5s infinite; --base-o: 0.65; }
  .rh--3  { animation: harvest-pulse 3.5s ease-in-out 1.0s infinite; --base-o: 0.75; }
  .rh--4  { animation: harvest-pulse 3.5s ease-in-out 1.5s infinite; --base-o: 0.6; }
  .rh--5  { animation: harvest-pulse 3.5s ease-in-out 2.0s infinite; --base-o: 0.5; }
  .rh--6  { animation: harvest-pulse 3.5s ease-in-out 0.3s infinite; --base-o: 0.7; }
  .rh--7  { animation: harvest-pulse 3.5s ease-in-out 0.8s infinite; --base-o: 0.85; }
  .rh--8  { animation: harvest-pulse 3.5s ease-in-out 1.3s infinite; --base-o: 0.75; }
  .rh--9  { animation: harvest-pulse 3.5s ease-in-out 1.8s infinite; --base-o: 0.6; }
  .rh--10 { animation: harvest-pulse 3.5s ease-in-out 0.6s infinite; --base-o: 0.55; }
  .rh--11 { animation: harvest-pulse 3.5s ease-in-out 1.1s infinite; --base-o: 0.7; }
  .rh--12 { animation: harvest-pulse 3.5s ease-in-out 1.6s infinite; --base-o: 0.6; }

  @keyframes harvest-pulse {
    0%, 100% { opacity: var(--base-o); transform: translateY(0) scale(1); }
    15% { opacity: 1; transform: translateY(-3px) scale(1.06); filter: brightness(1.2); }
    30% { opacity: var(--base-o); transform: translateY(0) scale(1); filter: brightness(1); }
  }

  /* --- Flow lines --- */
  .pipeline__flow { width: 440px; height: 55px; overflow: visible; }

  .flow-line { stroke-dasharray: 6 6; animation: flow-dash 1.8s linear infinite; }

  .fl--1 { animation-delay: 0s; }
  .fl--2 { animation-delay: 0.4s; }
  .fl--3 { animation-delay: 0.8s; }
  .fl--4 { animation-delay: 1.2s; }
  .fl--5 { animation-delay: 1.6s; }
  .fl--6 { animation-delay: 0.2s; }
  .fl--7 { animation-delay: 0.6s; }
  .fl--8 { animation-delay: 1.0s; }
  .fl--9 { animation-delay: 1.4s; }
  .fl--10 { animation-delay: 1.8s; }

  @keyframes flow-dash { to { stroke-dashoffset: -24; } }
  .flow--bottom .flow-line { animation-name: flow-dash-down; }
  @keyframes flow-dash-down { to { stroke-dashoffset: 24; } }

  /* --- MCP core --- */
  .pipeline__mcp { height: 120px; justify-content: center; }

  .mcp-core {
    position: relative;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mcp-ring { position: absolute; border-radius: 50%; }

  .mcp-ring--outer {
    inset: -10px;
    border: 1.5px solid rgba(200, 169, 110, 0.2);
    animation: mcp-spin 14s linear infinite;
  }

  .mcp-ring--outer::before {
    content: '';
    position: absolute;
    top: -3px; left: 50%; transform: translateX(-50%);
    width: 6px; height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
    opacity: 0.6;
    box-shadow: 0 0 10px rgba(200, 169, 110, 0.5);
  }

  .mcp-ring--inner {
    inset: -3px;
    border: 1px solid rgba(200, 169, 110, 0.1);
    animation: mcp-spin 10s linear infinite reverse;
  }

  .mcp-ring--inner::before {
    content: '';
    position: absolute;
    bottom: -3px; left: 50%; transform: translateX(-50%);
    width: 4px; height: 4px;
    background: var(--color-accent);
    border-radius: 50%;
    opacity: 0.35;
  }

  .mcp-center {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(200, 169, 110, 0.15) 0%, rgba(200, 169, 110, 0.04) 70%, transparent 100%);
    border: 1px solid rgba(200, 169, 110, 0.15);
    animation: mcp-pulse 2.5s ease-in-out infinite;
  }

  @keyframes mcp-spin { to { transform: rotate(360deg); } }
  @keyframes mcp-pulse {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.08); opacity: 1; }
  }

  /* --- DAG agents --- */
  .pipeline__dag {
    height: 72px;
    gap: 0;
    position: relative;
    justify-content: center;
  }

  .dag-connections {
    position: absolute;
    width: 440px;
    height: 60px;
    top: 6px;
    pointer-events: none;
  }

  .dag-agent {
    position: relative;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 1px solid rgba(200, 169, 110, 0.15);
    background: var(--color-bg-elevated);
    z-index: 1;
    margin: 0 14px;
  }

  .agent-icon { opacity: 0.7; }

  .da--1 { animation: agent-research 6s ease-in-out infinite; }
  .da--2 { animation: agent-analyze 6s ease-in-out 1.2s infinite; }
  .da--3 { animation: agent-build 6s ease-in-out 2.4s infinite; }
  .da--4 { animation: agent-review 6s ease-in-out 3.6s infinite; }
  .da--5 { animation: agent-deliver 6s ease-in-out 4.8s infinite; }

  @keyframes agent-research {
    0%, 18%, 100% { transform: translateY(0) rotate(0deg); }
    4% { transform: translateY(-4px) rotate(-6deg); }
    8% { transform: translateY(-2px) rotate(-3deg); }
    12% { transform: translateY(-5px) rotate(-8deg); }
    15% { transform: translateY(0) rotate(0deg); border-color: rgba(200,169,110,0.5); }
  }

  @keyframes agent-analyze {
    0%, 18%, 100% { transform: translateY(0); }
    2% { transform: translateY(-1px) translateX(1px); }
    4% { transform: translateY(1px) translateX(-1px); }
    6% { transform: translateY(-2px) translateX(1px); }
    8% { transform: translateY(1px) translateX(-1px); }
    10% { transform: translateY(-1px); }
    14% { transform: scale(1.04); border-color: rgba(200,169,110,0.5); }
    16% { transform: scale(1); }
  }

  @keyframes agent-build {
    0%, 18%, 100% { transform: translateY(0) scale(1); }
    3% { transform: translateY(-6px) scale(1.02); }
    6% { transform: translateY(-3px) scale(1.05); }
    9% { transform: translateY(-7px) scale(1.08); }
    12% { transform: translateY(-2px) scale(1.04); border-color: rgba(200,169,110,0.5); }
    15% { transform: translateY(0) scale(1); }
  }

  @keyframes agent-review {
    0%, 18%, 100% { transform: translateY(0); }
    3% { transform: translateY(-5px); }
    6% { transform: translateY(1px); }
    9% { transform: translateY(-4px); }
    12% { transform: translateY(0); border-color: rgba(200,169,110,0.5); }
  }

  @keyframes agent-deliver {
    0%, 18%, 100% { transform: translateX(0) scale(1); }
    4% { transform: translateX(3px) scale(1.02); }
    8% { transform: translateX(8px) scale(1.04); }
    10% { transform: translateX(12px) scale(1.06); border-color: rgba(200,169,110,0.6); }
    13% { transform: translateX(4px) scale(1.02); }
    16% { transform: translateX(0) scale(1); }
  }

  .dag-agent::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 12px;
    border: 1.5px solid var(--color-accent);
    opacity: 0;
  }

  .da--1::after { animation: agent-glow 6s ease-out 0.3s infinite; }
  .da--2::after { animation: agent-glow 6s ease-out 1.5s infinite; }
  .da--3::after { animation: agent-glow 6s ease-out 2.7s infinite; }
  .da--4::after { animation: agent-glow 6s ease-out 3.9s infinite; }
  .da--5::after { animation: agent-glow 6s ease-out 5.1s infinite; }

  @keyframes agent-glow {
    0%, 15%, 100% { opacity: 0; box-shadow: none; }
    3% { opacity: 0.5; box-shadow: 0 0 14px rgba(200,169,110,0.35); }
    8% { opacity: 0.2; box-shadow: 0 0 6px rgba(200,169,110,0.1); }
